{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/seljuksai-coding",
  "small_model": "9router/gemini-2.5-flash",
  "instructions": [
    "C:\\Users\\gnasution\\.config\\opencode\\AGENTS.caveman.md"
  ],
  "permission": {
    "skill": {
      "caveman": "allow",
      "caveman-commit": "allow",
      "caveman-review": "allow",
      "caveman-help": "allow",
      "caveman-compress": "allow"
    }
  }, 
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "https://9router.fithlail.my.id/v1",
        "apiKey": "sk-d3a40b875db690e2-2zrwlr-1957b2d7"
      },
      "models": {
        "seljuksai-coding": {
          "name": "seljuksai-coding"
        },
        "claude-3-7-sonnet": {
          "name": "Claude 3.7 Sonnet"
        },
         "claude-3-5-sonnet": {
          "name": "Claude 3.5 Sonnet"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gpt-4o": {
          "name": "GPT-4o"
        },
        "deepseek-chat": {
          "name": "DeepSeek V3"
        }
      }
    }
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\09.Programming\\New OpenCode Project\\it-helpdesk-api"
      ],
      "enabled": true
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },

    "postgres": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:POSTGRES_MCP_URL}"
      ],
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PAT}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      },
      "enabled": true
    }
  },

  "permission": {
    "filesystem_*": "ask",
    "postgres_*": "ask",
    "github_*": "ask"
  }
}